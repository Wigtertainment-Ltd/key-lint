{
	"name": "@key-lint/core",
	"version": "1.3.0",
	"description": "Framework-agnostic i18n scan engine used by the KeyLint desktop app and CLI.",
	"author": "Wigtertainment Ltd",
	"license": "MIT",
	"homepage": "https://github.com/Wigtertainment-Ltd/key-lint/tree/main/packages/core",
	"repository": {
		"type": "git",
		"url": "https://github.com/Wigtertainment-Ltd/key-lint.git",
		"directory": "packages/core"
	},
	"bugs": {
		"url": "https://github.com/Wigtertainment-Ltd/key-lint/issues",
		"email": "keylint@wigtertainment.ltd"
	},
	"keywords": [
		"i18n",
		"internationalization",
		"translation",
		"localization",
		"key-audit",
		"lint",
		"angular",
		"ngx-translate"
	],
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"default": "./dist/node.js"
		},
		"./detection": {
			"types": "./dist/detection.d.ts",
			"default": "./dist/detection.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"lint": "eslint \"src/**/*.ts\"",
		"test": "vitest run",
		"publish:pkg": "npm run build && npm publish"
	},
	"dependencies": {
		"typescript": "~6.0.3"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"vitest": "^4.1.10"
	}
}
