{
	"name": "key-lint",
	"version": "1.2.1",
	"description": "Desktop tool for auditing i18n translation keys in Angular projects.",
	"author": "Wigtertainment Ltd",
	"license": "MIT",
	"homepage": "https://github.com/Wigtertainment-Ltd/key-lint",
	"repository": {
		"type": "git",
		"url": "https://github.com/Wigtertainment-Ltd/key-lint.git"
	},
	"bugs": {
		"url": "https://github.com/Wigtertainment-Ltd/key-lint/issues",
		"email": "keylint@wigtertainment.ltd"
	},
	"keywords": [
		"i18n",
		"internationalization",
		"translation",
		"localization",
		"key-audit",
		"lint",
		"angular",
		"electron"
	],
	"main": "app.js",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"ng": "ng",
		"start": "npm run build:core && concurrently -k \"ng serve --hmr\" \"wait-on tcp:4200 && cross-env ELECTRON_START_URL=http://localhost:4200 electron .\"",
		"build": "npm run build:core && ng build",
		"build:core": "npm run build --workspace @key-lint/core",
		"build:cli": "npm run build --workspace @key-lint/cli",
		"build:electron": "npm run build:core && ng build --configuration production --base-href ./",
		"start:dist": "npm run build:electron && electron .",
		"pack:win": "npm run build:electron && electron-builder --win --dir",
		"dist:win": "npm run build:electron && electron-builder --win --publish never",
		"publish:win": "npm run build:electron && electron-builder --win --publish always",
		"test": "npm run build:core && ng test",
		"test:electron": "node --test electron/ipc-handlers.spec.cjs electron/preload.spec.cjs",
		"test:packages": "npm run build:core && npm run test --workspaces --if-present && npm run test:electron",
		"lint": "ng lint",
		"e2e": "ng e2e",
		"icons": "powershell -NoProfile -ExecutionPolicy Bypass -File build/generate-icons.ps1"
	},
	"private": true,
	"dependencies": {
		"@angular/animations": "22.1.2",
		"@angular/common": "22.1.2",
		"@angular/compiler": "22.1.2",
		"@angular/core": "22.1.2",
		"@angular/forms": "22.1.2",
		"@angular/platform-browser": "22.1.2",
		"@angular/platform-browser-dynamic": "22.1.2",
		"@angular/router": "22.1.2",
		"@ngx-translate/core": "18.0.0",
		"@ngx-translate/http-loader": "18.0.0",
		"dayjs": "1.11.23",
		"electron-updater": "6.8.9",
		"rxjs": "7.8.2",
		"tslib": "2.8.1",
		"zone.js": "0.16.2"
	},
	"devDependencies": {
		"@angular-devkit/build-angular": "22.1.4",
		"@angular/cli": "22.1.4",
		"@angular/compiler-cli": "22.1.2",
		"@key-lint/core": "^1.2.0",
		"@types/jasmine": "6.0.0",
		"concurrently": "10.0.5",
		"cross-env": "10.1.0",
		"electron": "43.4.0",
		"electron-builder": "26.15.3",
		"eslint": "10.8.1",
		"jasmine-core": "6.3.0",
		"karma": "6.4.4",
		"karma-chrome-launcher": "3.2.0",
		"karma-coverage": "2.2.1",
		"karma-jasmine": "5.1.0",
		"karma-jasmine-html-reporter": "2.2.0",
		"prettier": "3.9.6",
		"typescript": "6.0.3",
		"wait-on": "9.1.0"
	}
}
