{
	"name": "check-i18n",
	"version": "1.0.0",
	"description": "Desktop tool for auditing i18n translation keys in Angular projects.",
	"author": "Wigtertainment Ltd",
	"homepage": "./",
	"main": "app.js",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"ng": "ng",
		"start": "npm run build:core && concurrently -k \"ng serve --hmr\" \"wait-on tcp:4200 && cross-env ELECTRON_START_URL=http://localhost:4200 electron .\"",
		"build": "npm run build:core && ng build",
		"build:core": "npm run build --workspace @check-i18n/core",
		"build:cli": "npm run build --workspace @check-i18n/cli",
		"build:electron": "npm run build:core && ng build --configuration production --base-href ./",
		"start:dist": "npm run build:electron && electron .",
		"pack:win": "npm run build:electron && electron-builder --win --dir",
		"dist:win": "npm run build:electron && electron-builder --win --publish never",
		"publish:win": "npm run build:electron && electron-builder --win --publish always",
		"test": "npm run build:core && ng test",
		"test:packages": "npm run build:core && npm run test --workspaces --if-present",
		"lint": "ng lint",
		"e2e": "ng e2e",
		"icons": "powershell -NoProfile -ExecutionPolicy Bypass -File build/generate-icons.ps1"
	},
	"private": true,
	"dependencies": {
		"@angular/animations": "^18.1.0",
		"@angular/common": "^18.1.0",
		"@angular/compiler": "^18.1.0",
		"@angular/core": "^18.1.0",
		"@angular/forms": "^18.1.0",
		"@angular/platform-browser": "^18.1.0",
		"@angular/platform-browser-dynamic": "^18.1.0",
		"@angular/router": "^18.1.0",
		"@electron/remote": "^2.1.2",
		"@ngx-translate/core": "^15.0.0",
		"@ngx-translate/http-loader": "^8.0.0",
		"@wigtertainment-ltd/comp-lib": "^0.0.9",
		"dayjs": "^1.11.12",
		"electron-updater": "^6.3.9",
		"primeflex": "^3.3.1",
		"primeng": "^17.18.8",
		"rxjs": "~7.8.0",
		"tslib": "^2.3.0",
		"zone.js": "~0.14.3"
	},
	"devDependencies": {
		"@angular-devkit/build-angular": "^18.1.4",
		"@angular/cli": "^18.1.4",
		"@angular/compiler-cli": "^18.1.0",
		"@check-i18n/core": "^1.0.0",
		"@types/jasmine": "~5.1.0",
		"concurrently": "^9.0.1",
		"cross-env": "^7.0.3",
		"electron": "^31.3.1",
		"electron-builder": "^25.1.8",
		"eslint": "^9.9.0",
		"jasmine-core": "~5.1.0",
		"karma": "~6.4.0",
		"karma-chrome-launcher": "~3.2.0",
		"karma-coverage": "~2.2.0",
		"karma-jasmine": "~5.1.0",
		"karma-jasmine-html-reporter": "~2.1.0",
		"prettier": "^3.3.3",
		"typescript": "~5.5.2",
		"wait-on": "^8.0.1"
	}
}
