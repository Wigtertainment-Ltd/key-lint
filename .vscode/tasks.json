{
  // For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            // Match any output, including an empty line, to mark the background build as active.
            "regexp": "(.*?)"
          },
          "endsPattern": {
            // Match Angular's stable completion phrase to mark the background build as ready.
            "regexp": "bundle generation complete"
          }
        }
      }
    },
    {
      "type": "npm",
      "script": "test",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            // Match any output, including an empty line, to mark the background test task as active.
            "regexp": "(.*?)"
          },
          "endsPattern": {
            // Match Angular's stable completion phrase to mark the background test task as ready.
            "regexp": "bundle generation complete"
          }
        }
      }
    }
  ]
}
