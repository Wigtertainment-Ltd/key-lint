pipeline {
    agent {
        docker { image 'node:20-alpine' }
    }

    stages {
        stage('KeyLint scan') {
            steps {
                sh '''
                    npx --yes @key-lint/cli scan . --no-color --quiet \
                        --max-errors 0 \
                        --output json=keylint-report/keylint.json \
                        --output markdown=keylint-report/keylint.md
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'keylint-report/**', allowEmptyArchive: true
        }
    }
}
